# =============================================================================
# AI RECEPTIONIST — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Voice Provider (Vapi) ---
# Supported: vapi
VOICE_PROVIDER=vapi
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_WEBHOOK_SECRET=

# --- AI Provider (Anthropic / Claude) ---
# Supported: anthropic
AI_PROVIDER=anthropic
AI_PROVIDER_API_KEY=

# --- Google OAuth (for Calendar integration) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://evano-ai-kappa.vercel.app/api/integrations/google-calendar/callback

# --- App ---
NEXT_PUBLIC_APP_URL=https://evano-ai-kappa.vercel.app

# --- Integrations (encrypts OAuth tokens at rest; 32 bytes base64: openssl rand -base64 32) ---
INTEGRATIONS_ENCRYPTION_KEY=

# --- Vapi public key (browser test calls; safe to expose) ---
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
